@startuml

!pragma layout smetana

class Main {
    + {static} void main(String[] args)
    - {static} void printLogo()
}

class StreamingPlatform {
    - String name
    - TextUI ui
    - SessionService sessionService
    - SearchService searchService
    - AccountUI accountUI
    + StreamingPlatform(String name, SearchService searchService, SessionService sessionService, AccountUI accountUI)
    + void startMenu()
    + void mainMenu()
    + void searchMedia()
    - void chooseMediaMenu(ArrayList<Media> mediaArrayList)
    + void displaySpecificMedia(Media media)
    - void displaySeasonMenu(Series series)
}

class User {
    - String username
    - String password
    - ArrayList<Media> savedMedia
    - ArrayList<Media> watchedMedia
    - TextUI ui
    - boolean running
    + User(String username, String password, ArrayList<Media> savedMedia , ArrayList<Media> watchedMedia, TextUI ui)
    + void addSavedMedia(Media media)
    + void removeSavedMedia(Media media)
    + void addWatchedMedia(Media media)
    + void userInformation(AccountUI accountUI)
    - void showWatchedList()
    - void displaySavedList()
    + String getUsername()
    + String getPassword()
    + boolean checkPassword(String password)
    + void setPassword(String password)
    + ArrayList<Media> getSavedMedia()
    + ArrayList<Media> getWatchedMedia()
}

abstract class Media {
    - String name;
    - String releaseYear;
    - ArrayList<Genre> genre;
    - double rating;
    + Media(String name, double rating, String releaseYear, ArrayList<Genre> genre)
    + String getName()
    + double getRating()
    + int getReleaseYear()
    + ArrayList<Genre> getGenres()
    + boolean containsGenre(Genre genre)
}

interface PlayableMedia {
    + void playMedia(User user, Media media)
}

class Series {
    - ArrayList<Season> seasons
    + Series(String name, double rating, String releaseYear, ArrayList<Genre> genre, ArrayList<Season> seasons)
    + ArrayList<Season> getSeasons()
}

class Season {
    - String season
    - String episodes
    + Season(String season)
    + void playMedia(User user, Media media)
    + String toString()
}

class Film {
    + Film(String name, double rating, String releaseYear, ArrayList<Genre> genre)
    + void playMedia(User user, Media media)
}

enum Genre {
    Crime
    Drama
    Biography
    History
    Sport
    Romance
    War
    Mystery
    Adventure
    Family
    Fantasy
    Thriller
    Horror
    FilmNoir
    Musical
    Action
    SciFi
    Comedy
    Western
    Music
    Animation
    Documentary
    TalkShow

}

package util {
    class FileIO {
        + void saveData(ArrayList<String> data, String path, String header)
        + ArrayList<String> readData(String path)
        + String[] readData(String path, int length)
    }

    class TextUI {
        - Scanner scan
        + boolean promptBinary(String msg)
        + String promptText(String msg)
        + int promptNumeric(String msg)
        + ArrayList<String> promptChoice(ArrayList<String> options, int limit, String msg)
        + void displayMessage(String msg)
        + void displayList(ArrayList<String> list, String msg)
        + int readInt(String msg, int min, int max)
    }

    class Menu {
        - TextUI ui
        - String title
        - list<Action> actions
        + Menu(TextUI ui, String title)
        + Menu add(String text, Runnable runnable)
        + void show()
    }

    class Action {
        - String text
        - Runnable runnable
        + Action(String text, Runnable runnable)
        + String getText()
        + void run()
    }

    class DataLoader {
        - FileIO fileIO
        + void loadFilm(String path)
        + void loadSeries(String path)
        - ArrayList<Genre> loadGenres(String genreString)
        - double loadRating(String ratingString)
        - ArrayList<String> loadSeasons(String seasonsString)
    }
}

class SearchService {
    - TextUI ui
    - ArrayList<Media> medias
    + SearchService (TextUI ui, DataLoader dataLoader)
    + ArrayList<Media> searchByName()
    + ArrayList<Media> searchByGenre()
    + ArrayList<Media> searchByRating()
    + ArrayList<Media> searchByReleaseYear()
}

class SessionService {
    - {static} String HEADER
    - String path
    - ArrayList<Media> medias
    - ArrayList<User> users
    - FileIO fileIO
    - User currentUser
    - TextUI ui
    + SessionService (String path, ArrayList<Media> medias)
    + void loadUsers()
    + void saveUser()
    + boolean login(String username, String password)
    + void createAccount(String username, String password)
    + void changePassword(String currentPassword, String newPassword)
    + void logout()
    + boolean userExists(String username)
    + User getCurrentUser()
    + boolean isLoggedIn()
    - User findUser(String username)
    + void validateCredential(String value, String fieldName)
    - ArrayList<Media> findMediaByNames(String namesString)
    - Media findMedia(String name)
    - String joinMediaNames(ArrayList<Media> mediaList)
}

class AccountUI{
    - {static} int MAX_LOGIN_ATTEMPTS
    - TextUI ui
    - SessionService sessionService
    + AccountUI (TextUI ui, SessionService sessionService)
    + boolean login()
    + boolean createAccount()
    + boolean changePassword()
    - String promptUsername()
    - String promptPassword()

}


Main *-- "1" StreamingPlatform : has-a

StreamingPlatform *-- "200" Media : has-a
StreamingPlatform *-- "1..*" Menu : has-a
StreamingPlatform *-- "1" DataLoader : has-a
StreamingPlatform *-- "1" SearchService : has-a
StreamingPlatform *-- "1" TextUI : has-a
StreamingPlatform *-- "1" SessionService : has-a
StreamingPlatform *-- "1" AccountUI : has-a

Film <|.. "1" PlayableMedia : is-a
Season <|.. "1" PlayableMedia : is-a

Media <|-- "100" Film : is-a
Media <|-- "100" Series : is-a
Media *- "1..*" Genre : has-a

Series *-- "1..*" Season : has-a

Menu *-- "1" TextUI : has-a
Menu *-- "1..*" Action : has-a

DataLoader *-- "1" FileIO : has-a

SessionService *-- "1..*" User : has-a
SessionService *-- "1" FileIO : has-a
SessionService *-- "1" TextUI : has-a

SearchService *-- "1" TextUI : has-a

AccountUI *-- "1" TextUI : has-a
AccountUI *-- "1" SessionService : has-a

User *-- "1" TextUI : has-a





@enduml