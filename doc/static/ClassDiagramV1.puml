@startuml

!pragma layout smetana

class Main {
    + {static} static void main(String[] args)
}

class StreamingPlatform {
    - String name
    - ArrayList<User>

    + StreamingPlatform(String name)
    + StartMenu()
    + MainMenu()
}

class User {
    - String username
    - String password
    - ArrayList<Media> savedMedia
    - ArrayList<Media> watchedMedia
    + void addSavedMedia(Media media)
    + void removeSavedMedia(Media media)
    + void addWatchedMedia(Media media)
}

abstract class Media {
    - String name
    - double rating
    - int releaseYear
    - ArrayList<Genre> genre
    + Media(String name, double rating, int releaseYear, ArrayList<Genre> genre)
}

interface PlayableMedia {
    + void playMedia()
}

class Series {
    - ArrayList<Season> seasons
    + Series(String name, double rating, int releaseYear, ArrayList<Genre> genre, ArrayList<Season> seasons)
}

class Season {
    - ArrayList<Episode> episodes
    + Season(ArrayList<Episode> episodes)
}

class Episode {
   + void playMedia()
}

class Film {
    + void playMedia()
}

enum Genre {
}

package util {
    class FileIO {
        + void saveData(ArrayList<String> data, String path, String header)
        + ArrayList<String> readData(String path)
        + String[] readData(String path, int length)
    }
    class TextUI {
        - Scanner scan
        + boolean promptBinary(String msg)
        + String promptText(String msg)
        + int promptNumeric(String msg)
        + ArrayList<String> promptChoice(ArrayList<String> options, int limit, String msg)
        + void displayMessage(String msg)
        + void displayList(ArrayList<String> list, String msg)
    }

    class DataLoader {
    }

}

Main *-- "1" StreamingPlatform : has-a

StreamingPlatform *-- "200" Media : has-a
StreamingPlatform *-- "*" User : has-a
StreamingPlatform *-- "1" TextUI : has-a
StreamingPlatform *-- "1" FileIO : has-a

Film <|.. "1" PlayableMedia : is-a
Episode <|.. "1" PlayableMedia : is-a

Media <|-- "100" Film : is-a
Media <|-- "100" Series : is-a
Media *-- "1..*" Genre : has-a


Series *-- "1..*" Season : has-a
Season *-- "1..*" Episode : has-a





@enduml