@startuml
'https://plantuml.com/use-case-diagram

note "User must have completed\nloginUseCase.puml" as N1

User --> (MainMenu)

(MainMenu) --> (SearchMedia)
(SearchMedia) --> (NameOfMedia)
(SearchMedia) --> (GenreOfMedia)
(NameOfMedia) --> (ReturnToMainMenu)
(GenreOfMedia) --> (ReturnToMainMenu)

(MainMenu) --> (UserInformation)
(UserInformation) --> (SeenMedia)
(UserInformation) --> (SavedMedia)
(SeenMedia) --> (ReturnToMainMenu)
(SavedMedia) --> (ReturnToMainMenu)

(ReturnToMainMenu) ---> (MainMenu)

@enduml